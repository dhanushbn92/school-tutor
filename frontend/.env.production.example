# Copy to `.env.production` (or set in CI) before running `npm run build` for
# a Firebase Hosting deploy. Vite inlines VITE_*-prefixed vars at build time.

# Cloud Run service URL — `gcloud run services describe school-tuter-api --format='value(status.url)'`.
VITE_API_BASE_URL=https://school-tuter-api-XXXXXX-uc.a.run.app
