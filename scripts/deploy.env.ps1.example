# Copy this to scripts/deploy.env.ps1 and fill in real values. The
# deploy_*.ps1 scripts dot-source it automatically. DO NOT commit the
# populated file.

$env:GCP_PROJECT      = "school-tuter-prod"
$env:GCP_REGION       = "asia-south1"
$env:AR_REPO          = "school-tuter"
$env:SERVICE_NAME     = "school-tuter-api"
$env:GCS_BUCKET       = "school-tuter-artifacts"

$env:DATABASE_URL     = "postgresql+psycopg://USER:PASS@HOST:5432/DBNAME?sslmode=require"
$env:JWT_SECRET       = "change-me-to-a-long-random-string"
$env:ALLOWED_ORIGINS  = "https://school-tuter.web.app,https://school-tuter.firebaseapp.com,https://school-tutor-hub.web.app,https://school-tutor-hub.firebaseapp.com"

$env:LLM_PROVIDER     = "anthropic"
$env:ANTHROPIC_API_KEY = "sk-ant-..."
$env:GROQ_API_KEY     = ""
$env:OPENAI_API_KEY   = ""

$env:FIREBASE_PROJECT  = "school-tuter"
$env:VITE_API_BASE_URL = "https://school-tuter-api-XXXXXX-uc.a.run.app"
