# Copy this to scripts/deploy.env (bash) or scripts/deploy.env.ps1 (PowerShell)
# and fill in the values. The deploy_*.{sh,ps1} scripts source it automatically.
# DO NOT commit the populated file.

# --- GCP ---
GCP_PROJECT=school-tuter-prod
GCP_REGION=asia-south1
AR_REPO=school-tuter
SERVICE_NAME=school-tuter-api
GCS_BUCKET=school-tuter-artifacts

# --- Backend secrets ---
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/DBNAME?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=https://school-tuter.web.app,https://school-tuter.firebaseapp.com

# --- LLM (pick one — leave others blank) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Firebase ---
FIREBASE_PROJECT=school-tuter
VITE_API_BASE_URL=https://school-tuter-api-XXXXXX-uc.a.run.app
