    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "a^3 + b^3 = (a + b)(a^2 − ab + ____).",
     "answer": "b^2",
     "explanation": "Sum-of-cubes identity."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "8x^3 = (____)^3.",
     "answer": "2x",
