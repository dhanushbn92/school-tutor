    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "(a − b)^3 expands to:",
     "options": ["a^3 − b^3", "a^3 − 3a^2 b + 3ab^2 − b^3", "a^3 + 3a^2 b − 3ab^2 + b^3", "a^3 − 3ab^2 + b^3"],
     "answer": "a^3 − 3a^2 b + 3ab^2 − b^3",
     "explanation": "Cube of a difference: signs alternate +, −, +, −."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "a^3 + b^3 factors as:",
     "options": ["(a + b)(a^2 + ab + b^2)", "(a + b)(a^2 − ab + b^2)", "(a − b)(a^2 + ab + b^2)", "(a + b)^3"],
     "answer": "(a + b)(a^2 − ab + b^2)",
     "explanation": "Sum of cubes: (a + b) times (a^2 − ab + b^2)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "a^3 − b^3 factors as:",
     "options": ["(a − b)(a^2 − ab + b^2)", "(a − b)(a^2 + ab + b^2)", "(a + b)(a^2 − ab + b^2)", "(a − b)^3"],
     "answer": "(a − b)(a^2 + ab + b^2)",
     "explanation": "Difference of cubes: (a − b) times (a^2 + ab + b^2)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 27x^3 + 8.",
     "options": ["(3x + 2)(9x^2 − 6x + 4)", "(3x + 2)(9x^2 + 6x + 4)", "(3x − 2)(9x^2 − 6x + 4)", "(3x + 2)(3x^2 − 6x + 4)"],
     "answer": "(3x + 2)(9x^2 − 6x + 4)",
     "explanation": "(3x)^3 + 2^3 = (3x + 2)((3x)^2 − (3x)(2) + 2^2) = (3x + 2)(9x^2 − 6x + 4)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 8a^3 − 1.",
     "options": ["(2a − 1)(4a^2 + 2a + 1)", "(2a − 1)(4a^2 − 2a + 1)", "(2a + 1)(4a^2 − 2a + 1)", "(2a − 1)(2a^2 + 2a + 1)"],
     "answer": "(2a − 1)(4a^2 + 2a + 1)",
     "explanation": "(2a)^3 − 1^3 = (2a − 1)((2a)^2 + (2a)(1) + 1^2) = (2a − 1)(4a^2 + 2a + 1)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Expand (x + 1)^3.",
