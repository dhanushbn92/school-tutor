    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "(a + b)^3 expands to:",
     "options": ["a^3 + b^3", "a^3 + 3a^2 b + 3ab^2 + b^3", "a^3 + 3ab + b^3", "a^3 + 3a^2 b^2 + b^3"],
     "answer": "a^3 + 3a^2 b + 3ab^2 + b^3",
