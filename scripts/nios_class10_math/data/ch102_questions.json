    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "(a − b)^2 = a^2 − 2ab + ____.",
     "answer": "b^2",
     "explanation": "Square-of-difference identity."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "a^2 − b^2 = (a + b)(____).",
