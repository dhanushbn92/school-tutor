  "questions": [
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "(a + b)^2 expands to:",
     "options": ["a^2 + b^2", "a^2 + ab + b^2", "a^2 + 2ab + b^2", "a^2 + 2b + b^2"],
     "answer": "a^2 + 2ab + b^2",
