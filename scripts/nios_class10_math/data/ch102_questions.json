    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-06", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor: 3xy + 2y + 9x + 6.",
     "options": ["(3x + 2)(y + 3)", "(3x − 2)(y + 3)", "(x + 2)(3y + 3)", "(3x + y)(2 + 3)"],
     "answer": "(3x + 2)(y + 3)",
     "explanation": "Group: y(3x + 2) + 3(3x + 2) = (3x + 2)(y + 3)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-07", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor x^2 − 11x + 30.",
     "options": ["(x − 5)(x − 6)", "(x − 3)(x − 10)", "(x + 5)(x + 6)", "(x − 2)(x − 15)"],
     "answer": "(x − 5)(x − 6)",
     "explanation": "Sum −11, product 30 → (−5, −6)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-07", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 4x^2 − 12x − 7.",
     "options": ["(2x − 7)(2x + 1)", "(2x + 7)(2x − 1)", "(4x − 7)(x + 1)", "(4x + 7)(x − 1)"],
     "answer": "(2x − 7)(2x + 1)",
     "explanation": "a·c = −28, sum −12 → (−14, 2). Split: 4x^2 − 14x + 2x − 7 = 2x(2x − 7) + 1(2x − 7) = (2x − 7)(2x + 1)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 9x^2 − 24x + 16.",
     "options": ["(3x − 4)^2", "(3x + 4)^2", "(9x − 16)(x − 1)", "(3x − 4)(3x + 4)"],
     "answer": "(3x − 4)^2",
     "explanation": "(3x)^2 − 2·(3x)·4 + 4^2 = (3x − 4)^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-08", "difficulty": "HARD", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "Factor x^4 − 1 completely.",
     "options": ["(x^2 − 1)(x^2 + 1)", "(x − 1)(x + 1)(x^2 + 1)", "(x − 1)^2(x + 1)^2", "(x^2 − 1)^2"],
     "answer": "(x − 1)(x + 1)(x^2 + 1)",
     "explanation": "x^4 − 1 = (x^2 − 1)(x^2 + 1) = (x − 1)(x + 1)(x^2 + 1) — apply difference of squares twice."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "If a + b = 7 and ab = 10, find a^2 + b^2.",
     "options": ["29", "39", "49", "59"],
     "answer": "29",
     "explanation": "(a + b)^2 = a^2 + 2ab + b^2, so a^2 + b^2 = (a + b)^2 − 2ab = 49 − 20 = 29."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "If a − b = 4 and ab = 5, find a^2 + b^2.",
     "options": ["16", "21", "26", "36"],
     "answer": "26",
     "explanation": "(a − b)^2 = a^2 − 2ab + b^2 → a^2 + b^2 = (a − b)^2 + 2ab = 16 + 10 = 26."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Compute 1001 × 999 using a special-product identity.",
     "options": ["999999", "1000001", "1000999", "999000"],
     "answer": "999999",
     "explanation": "(1000 + 1)(1000 − 1) = 1000000 − 1 = 999999."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 64 + a^3.",
     "options": ["(4 + a)(16 − 4a + a^2)", "(4 + a)(16 + 4a + a^2)", "(4 − a)(16 + 4a + a^2)", "(4 + a)^3"],
     "answer": "(4 + a)(16 − 4a + a^2)",
     "explanation": "a^3 + 4^3 = (a + 4)(a^2 − 4a + 16)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-05", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 4x^4 − 8x^3 + 12x^2.",
     "options": ["4x^2(x^2 − 2x + 3)", "2x^2(2x^2 − 4x + 6)", "x^2(4x^2 − 8x + 12)", "4x(x^3 − 2x^2 + 3x)"],
     "answer": "4x^2(x^2 − 2x + 3)",
     "explanation": "HCF is 4x^2; pull it out: 4x^2(x^2 − 2x + 3)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-07", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 5x^2 + 13x + 6.",
     "options": ["(5x + 3)(x + 2)", "(5x + 2)(x + 3)", "(5x + 6)(x + 1)", "(x + 6)(5x + 1)"],
     "answer": "(5x + 3)(x + 2)",
     "explanation": "a·c = 30, sum 13 → (3, 10). Split: 5x^2 + 3x + 10x + 6 = x(5x + 3) + 2(5x + 3) = (5x + 3)(x + 2)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-07", "difficulty": "HARD", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "Which factorisation of 6x^2 − x − 12 is correct?",
     "options": ["(3x − 4)(2x + 3)", "(3x + 4)(2x − 3)", "(6x − 1)(x − 12)", "(2x − 3)(3x − 4)"],
     "answer": "(3x + 4)(2x − 3)",
     "explanation": "a·c = −72; need sum −1 and product −72 → (−9, 8). Split: 6x^2 − 9x + 8x − 12 = 3x(2x − 3) + 4(2x − 3) = (2x − 3)(3x + 4). Verify: (3x + 4)(2x − 3) = 6x^2 − 9x + 8x − 12 = 6x^2 − x − 12 ✓."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor 25 − 9y^2.",
     "options": ["(5 + 3y)(5 − 3y)", "(5 + 3y)^2", "(5 − 3y)^2", "(25 − 9y)(1 + y)"],
     "answer": "(5 + 3y)(5 − 3y)",
     "explanation": "5^2 − (3y)^2 = (5 + 3y)(5 − 3y)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor x^2 − 2xy + y^2 − 9.",
     "options": ["(x − y − 3)(x − y + 3)", "(x − y + 3)^2", "(x + y − 3)(x + y + 3)", "Cannot be factored"],
     "answer": "(x − y − 3)(x − y + 3)",
     "explanation": "Group: (x − y)^2 − 3^2 — difference of squares with a = x − y, b = 3. So (x − y − 3)(x − y + 3)."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The expression a^2 + 2ab + b^2 is called a:",
     "options": ["Difference of squares", "Sum of cubes", "Perfect-square trinomial", "Quadratic polynomial in two variables only"],
     "answer": "Perfect-square trinomial",
     "explanation": "It is the expansion of (a + b)^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "(a − b)(a + b) − a^2 equals:",
     "options": ["b^2", "−b^2", "0", "2ab"],
     "answer": "−b^2",
     "explanation": "(a − b)(a + b) = a^2 − b^2, so (a^2 − b^2) − a^2 = −b^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "MEDIUM", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "If a + b = 5 and ab = 6, then a^3 + b^3 equals:",
     "options": ["35", "65", "95", "125"],
     "answer": "35",
     "explanation": "a^3 + b^3 = (a + b)((a + b)^2 − 3ab) = 5·(25 − 18) = 5·7 = 35. (Alternatively (a + b)^3 − 3ab(a + b) = 125 − 90 = 35.)"},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "HARD", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "If x + 1/x = 4, then x^3 + 1/x^3 equals:",
     "options": ["52", "60", "64", "76"],
     "answer": "52",
     "explanation": "(x + 1/x)^3 = x^3 + 1/x^3 + 3(x + 1/x). 64 = (x^3 + 1/x^3) + 12 → x^3 + 1/x^3 = 52."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Factor a^2 − 6a + 9 − b^2 completely.",
     "options": ["(a − 3 + b)(a − 3 − b)", "(a + 3 + b)(a + 3 − b)", "(a − 3)^2 − b", "(a − 3)^2(1 − b)"],
     "answer": "(a − 3 + b)(a − 3 − b)",
     "explanation": "a^2 − 6a + 9 = (a − 3)^2; then (a − 3)^2 − b^2 is a difference of squares: (a − 3 + b)(a − 3 − b)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Expand (2x + 3)^3.",
     "options": ["8x^3 + 36x^2 + 54x + 27", "8x^3 + 18x^2 + 54x + 27", "8x^3 + 36x^2 + 18x + 27", "8x^3 + 27"],
     "answer": "8x^3 + 36x^2 + 54x + 27",
     "explanation": "(a + b)^3 with a = 2x, b = 3: (2x)^3 + 3(2x)^2(3) + 3(2x)(3)^2 + 3^3 = 8x^3 + 36x^2 + 54x + 27."},

    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "(a + b)^2 = a^2 + b^2.",
     "options": ["True", "False"], "answer": "False",
