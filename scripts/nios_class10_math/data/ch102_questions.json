    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Expand (2a + 7b)^2.",
     "options": ["4a^2 + 14ab + 49b^2", "4a^2 + 28ab + 49b^2", "4a^2 + 28ab + 14b^2", "4a^2 + 49ab + 49b^2"],
     "answer": "4a^2 + 28ab + 49b^2",
     "explanation": "(2a)^2 + 2·(2a)·(7b) + (7b)^2 = 4a^2 + 28ab + 49b^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Expand (5p − 3q)^2.",
