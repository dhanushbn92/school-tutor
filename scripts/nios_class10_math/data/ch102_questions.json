    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-SPF-08", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "x^2 + 6x + 9 is a perfect-square trinomial.",
     "options": ["True", "False"], "answer": "True",
