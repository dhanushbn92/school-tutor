    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-SPF-05", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The HCF of 6x^2 and 9x is ____.",
     "answer": "3x",
     "explanation": "Numerical HCF 3, variable HCF x."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-SPF-07", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "To factor x^2 + 5x + 6, we need two numbers with sum 5 and product ____.",
