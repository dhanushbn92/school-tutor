    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-01", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Use (a + b)^2 to compute 102^2.",
     "options": ["10000", "10204", "10404", "10440"],
     "answer": "10404",
     "explanation": "102^2 = (100 + 2)^2 = 100^2 + 2·100·2 + 2^2 = 10000 + 400 + 4 = 10404."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "(a + b)(a − b) equals:",
     "options": ["a^2 + b^2", "a^2 − b^2", "a^2 − 2ab + b^2", "a^2 + 2ab + b^2"],
     "answer": "a^2 − b^2",
     "explanation": "Difference of squares: middle terms ab and −ab cancel, leaving a^2 − b^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Expand (x + 7)(x − 7).",
     "options": ["x^2 − 14", "x^2 + 49", "x^2 − 49", "x^2 + 14x − 49"],
     "answer": "x^2 − 49",
     "explanation": "(x + 7)(x − 7) = x^2 − 7^2 = x^2 − 49."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Expand (2p + 3q)(2p − 3q).",
     "options": ["4p^2 + 9q^2", "4p^2 − 9q^2", "2p^2 − 3q^2", "4p^2 + 6pq − 9q^2"],
     "answer": "4p^2 − 9q^2",
     "explanation": "(2p)^2 − (3q)^2 = 4p^2 − 9q^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Use (a + b)(a − b) = a^2 − b^2 to compute 103 × 97.",
     "options": ["10000", "9991", "9999", "10009"],
     "answer": "9991",
     "explanation": "103 × 97 = (100 + 3)(100 − 3) = 100^2 − 3^2 = 10000 − 9 = 9991."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-02", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Use (a + b)(a − b) to compute 51 × 49.",
     "options": ["2499", "2501", "2509", "2599"],
     "answer": "2499",
     "explanation": "(50 + 1)(50 − 1) = 2500 − 1 = 2499."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-03", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Expand (x + 2)(x + 3).",
