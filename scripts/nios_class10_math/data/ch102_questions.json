    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-05", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Factor 15p^3 q^2 − 25 p^2 q.",
     "options": ["5p^2 q(3pq − 5)", "5pq(3p^2 q − 5p)", "5p(3p^2 q^2 − 5pq)", "p^2 q(15pq − 25)"],
     "answer": "5p^2 q(3pq − 5)",
