    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-03", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Expand (x − 4)(x + 9).",
     "options": ["x^2 + 5x − 36", "x^2 + 13x + 36", "x^2 − 5x + 36", "x^2 + 5x + 36"],
     "answer": "x^2 + 5x − 36",
     "explanation": "a + b = −4 + 9 = 5, ab = (−4)(9) = −36; x^2 + 5x − 36."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-SPF-03", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "If (x + a)(x + b) = x^2 + 7x + 12, then {a, b} =",
