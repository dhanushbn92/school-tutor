{
  "title": "Arithmetic Progressions — Concept Map",
  "central_term": "Arithmetic Progressions",
  "branches": [
    {
      "label": "Definition",
      "details": [
        "AP: a, a + d, a + 2 d, …",
        "d = a_(n+1) − a_n is constant",
        "d > 0 ↑, d = 0 const, d < 0 ↓"
      ]
    },
    {
      "label": "n-th term",
      "details": [
        "a_n = a + (n − 1) d",
        "Find term, position, or d",
        "Common slip: a + n d (wrong)"
      ]
    },
    {
      "label": "Sum of n terms",
      "details": [
        "S_n = (n/2)(2 a + (n − 1) d)",
        "S_n = (n/2)(a + l)",
        "Derived by Gauss's pairing trick"
      ]
    },
    {
      "label": "Particular sums",
      "details": [
        "1 + 2 + … + n = n(n + 1)/2",
        "1 + 3 + … + (2 n − 1) = n^2",
        "2 + 4 + … + 2 n = n(n + 1)"
      ]
    },
    {
      "label": "Arithmetic mean",
      "details": [
        "AM(a, b) = (a + b)/2",
        "x, m, y in AP iff m = (x+y)/2",
        "Insert n means: d = (b − a)/(n + 1)"
      ]
    },
    {
      "label": "Word problems",
      "details": [
        "Savings, ladder, seating",
        "Identify a, d (or l)",
        "Reject non-natural n"
      ]
    }
  ],
