{
  "title": "Quadratic Equations — Concept Map",
  "central_term": "Quadratic Equations",
  "branches": [
    {
      "label": "Standard form",
      "details": [
        "a x^2 + b x + c = 0, a ≠ 0",
        "At most two real roots",
        "Roots are x-intercepts of y = a x^2 + b x + c"
      ]
    },
    {
      "label": "Factorisation",
      "details": [
        "Split the middle term",
        "Product = a × c, sum = b",
        "Zero-product property"
      ]
    },
    {
      "label": "Completing the square",
      "details": [
        "x^2 + 2 p x = (x + p)^2 − p^2",
        "Six-step algorithm",
        "Derives the quadratic formula"
      ]
    },
    {
      "label": "Quadratic formula",
      "details": [
        "x = (−b ± √(b^2 − 4 a c)) / (2 a)",
        "Sridharacharya formula",
        "Works for every quadratic"
      ]
    },
    {
      "label": "Discriminant",
      "details": [
        "D = b^2 − 4 a c",
        "D > 0: two real distinct",
        "D = 0: one repeated; D < 0: no real"
      ]
    },
    {
      "label": "Sum & product / word problems",
      "details": [
        "α + β = −b/a, α β = c/a",
        "x^2 − (p + q) x + p q = 0",
        "Reject roots that contradict context"
      ]
    }
  ],
