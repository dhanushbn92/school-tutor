{
  "title": "Exponents and Radicals — Concept Map",
  "central_term": "Exponents & Radicals",
  "branches": [
    {
      "label": "Positive exponents",
      "details": [
        "a^n = n factors of a",
        "a is the base; n is the exponent",
        "(−a)^n: even = +; odd = −"
      ]
    },
    {
      "label": "Five laws",
      "details": [
        "a^m × a^n = a^(m+n)",
        "a^m ÷ a^n = a^(m−n)",
        "(a^m)^n = a^(m·n)",
        "(ab)^n = a^n × b^n",
        "(a/b)^n = a^n / b^n"
      ]
    },
    {
      "label": "Zero & negative exponents",
      "details": [
        "a^0 = 1 (forced by product law)",
        "a^(−n) = 1 / a^n",
        "0^0 is undefined"
      ]
    },
    {
      "label": "Rational exponents",
      "details": [
        "n√a = a^(1/n)",
        "a^(m/n) = n√(a^m)",
        "Laws extend (positive bases)"
      ]
    },
    {
      "label": "Surds",
      "details": [
        "n√a with a rational, n√a irrational",
        "Pure / mixed",
        "Like / unlike"
      ]
    },
    {
      "label": "Rationalisation",
      "details": [
        "√a denominator → multiply by √a",
        "a + b√c denominator → multiply by a − b√c",
        "Uses (a + b√c)(a − b√c) = a² − b²c"
      ]
    }
  ],
