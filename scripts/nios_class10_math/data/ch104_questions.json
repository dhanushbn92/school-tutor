{
  "_meta": {"chapter_id": 104, "title": "Quadratic Equations", "board": "NIOS", "class_level": 10, "subject": "Mathematics"},
  "questions": [
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The standard form of a quadratic equation in x is:",
     "options": ["ax + b = 0", "ax^2 + bx + c = 0 (a ≠ 0)", "ax^3 + b = 0", "ax^2 + b = 0 (b ≠ 0)"],
     "answer": "ax^2 + bx + c = 0 (a ≠ 0)",
     "explanation": "Variable up to second power, with a ≠ 0."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "Which of these is a quadratic equation?",
     "options": ["3x + 5 = 0", "x^3 − x = 0", "2x^2 − x − 1 = 0", "1/x + 2 = 0"],
     "answer": "2x^2 − x − 1 = 0",
     "explanation": "Has highest power exactly 2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "In 2x^2 − 5x + 3 = 0, the coefficient b equals:",
     "options": ["2", "−5", "5", "3"],
     "answer": "−5",
     "explanation": "Coefficient of the linear term."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Re-arrange (x − 2)^2 = 5 in standard form.",
     "options": ["x^2 − 4x − 1 = 0", "x^2 − 4x + 1 = 0", "x^2 + 4x − 1 = 0", "x^2 − 4x − 9 = 0"],
     "answer": "x^2 − 4x − 1 = 0",
     "explanation": "Expand: x^2 − 4x + 4 = 5 → x^2 − 4x − 1 = 0."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "In x^2 − 9 = 0, the coefficient b equals:",
     "options": ["1", "0", "−9", "9"],
     "answer": "0",
     "explanation": "There is no linear term, so b = 0."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Is x = 3 a root of x^2 − 5x + 6 = 0?",
     "options": ["Yes", "No", "Only if combined with x = 1", "Cannot say"],
     "answer": "Yes",
     "explanation": "9 − 15 + 6 = 0 ✓."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Which value is NOT a root of x^2 − 7x + 12 = 0?",
     "options": ["3", "4", "6", "Both 3 and 4 are roots"],
     "answer": "6",
     "explanation": "p(6) = 36 − 42 + 12 = 6 ≠ 0; the actual roots are 3 and 4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-02", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The maximum number of real roots a quadratic can have is:",
     "options": ["1", "2", "3", "4"],
     "answer": "2",
     "explanation": "By the fundamental property, a degree-2 polynomial has at most 2 real roots."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Solve x^2 − 5x + 6 = 0 by factorisation.",
     "options": ["1, 6", "−2, −3", "2, 3", "−1, 6"],
     "answer": "2, 3",
     "explanation": "(x − 2)(x − 3) = 0; roots are 2 and 3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Solve x^2 − 9 = 0.",
     "options": ["±3", "±9", "3 only", "−3 only"],
     "answer": "±3",
     "explanation": "x^2 = 9 → x = ±3. (Or factor as (x − 3)(x + 3).)"},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve 2x^2 − 7x + 3 = 0.",
     "options": ["1/2, 3", "−1/2, −3", "2, 3", "1, 6"],
     "answer": "1/2, 3",
     "explanation": "(2x − 1)(x − 3) = 0 → x = 1/2 or x = 3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve x^2 + 7x + 12 = 0.",
     "options": ["−3, −4", "3, 4", "−2, −6", "2, 6"],
     "answer": "−3, −4",
     "explanation": "(x + 3)(x + 4) = 0; roots are −3 and −4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve 6x^2 + x − 12 = 0.",
     "options": ["3/2, −4/3", "−3/2, 4/3", "4/3, 3/2", "−4/3, −3/2"],
     "answer": "−3/2, 4/3",
     "explanation": "Split: 6x^2 + 9x − 8x − 12 = 3x(2x + 3) − 4(2x + 3) = (2x + 3)(3x − 4) = 0; x = −3/2, 4/3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "By completing the square, solve x^2 − 6x + 5 = 0.",
     "options": ["1, 5", "−1, −5", "2, 4", "0, 6"],
     "answer": "1, 5",
     "explanation": "x^2 − 6x = −5; add 9 → (x − 3)^2 = 4 → x = 3 ± 2 = 1 or 5."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "By completing the square, solve x^2 + 4x − 5 = 0.",
     "options": ["1, −5", "−1, 5", "1, 5", "−1, −5"],
     "answer": "1, −5",
     "explanation": "x^2 + 4x = 5; add 4 → (x + 2)^2 = 9 → x + 2 = ±3 → x = 1 or −5."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-04", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "When completing the square on x^2 + bx, what constant should be added?",
     "options": ["b/2", "(b/2)^2", "b^2", "b^2/4"],
     "answer": "(b/2)^2",
     "explanation": "(b/2)^2 = b^2/4 makes x^2 + bx + (b/2)^2 = (x + b/2)^2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The quadratic formula gives x =",
     "options": ["b ± √(b^2 − 4ac) / 2a", "(−b ± √(b^2 − 4ac)) / (2a)", "(b ± √(b^2 + 4ac)) / 2a", "(−b ± √(b^2 + 4ac)) / 2a"],
     "answer": "(−b ± √(b^2 − 4ac)) / (2a)",
     "explanation": "Standard quadratic formula."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Solve 2x^2 + 5x − 3 = 0 using the quadratic formula.",
     "options": ["1/2, −3", "−1/2, 3", "1, −3/2", "1/2, 3"],
     "answer": "1/2, −3",
     "explanation": "D = 25 + 24 = 49 → x = (−5 ± 7)/4 = 1/2 or −3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve x^2 − 4x + 1 = 0.",
     "options": ["2 ± √2", "2 ± √3", "1 ± √3", "4 ± √3"],
     "answer": "2 ± √3",
     "explanation": "D = 16 − 4 = 12 → x = (4 ± 2√3)/2 = 2 ± √3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve x^2 − x − 1 = 0.",
     "options": ["(1 ± √5)/2", "(−1 ± √5)/2", "(1 ± √3)/2", "(−1 ± √3)/2"],
     "answer": "(1 ± √5)/2",
     "explanation": "D = 1 + 4 = 5 → x = (1 ± √5)/2 (the golden ratio and its conjugate)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The discriminant of ax^2 + bx + c = 0 is:",
     "options": ["b^2 + 4ac", "b^2 − 4ac", "4ac − b^2", "a^2 − 4bc"],
     "answer": "b^2 − 4ac",
     "explanation": "Standard definition."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "EASY", "cognitive_level": "ANALYZE", "marks": 1,
     "question": "If D > 0, the quadratic has:",
     "options": ["No real roots", "Two equal real roots", "Two distinct real roots", "Cannot say"],
     "answer": "Two distinct real roots",
     "explanation": "Positive discriminant → two distinct real roots."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "EASY", "cognitive_level": "ANALYZE", "marks": 1,
     "question": "If D = 0, the quadratic has:",
     "options": ["No real roots", "Two equal real roots", "Two distinct real roots", "Three real roots"],
     "answer": "Two equal real roots",
     "explanation": "D = 0 → repeated root x = −b/(2a)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "EASY", "cognitive_level": "ANALYZE", "marks": 1,
     "question": "If D < 0, the quadratic has:",
     "options": ["Two equal real roots", "Two distinct real roots", "No real roots", "One real root"],
     "answer": "No real roots",
     "explanation": "Negative discriminant → roots are complex (no real solutions)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "The discriminant of x^2 − 6x + 9 = 0 is:",
     "options": ["0", "9", "12", "36"],
     "answer": "0",
     "explanation": "36 − 36 = 0; the quadratic has a repeated root x = 3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "For what value of k does kx^2 − 4x + 1 = 0 have equal roots?",
     "options": ["k = 1", "k = 2", "k = 4", "k = 8"],
     "answer": "k = 4",
     "explanation": "D = 16 − 4k = 0 → k = 4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "HARD", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "For what value(s) of k does x^2 + kx + 9 = 0 have equal roots?",
     "options": ["k = 6", "k = −6", "k = ±6", "k = 9"],
     "answer": "k = ±6",
     "explanation": "D = k^2 − 36 = 0 → k^2 = 36 → k = ±6."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "If α and β are the roots of ax^2 + bx + c = 0, then α + β =",
     "options": ["b/a", "−b/a", "c/a", "−c/a"],
     "answer": "−b/a",
     "explanation": "Sum of roots formula."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "If α and β are the roots of ax^2 + bx + c = 0, then α · β =",
     "options": ["b/a", "−b/a", "c/a", "−c/a"],
     "answer": "c/a",
     "explanation": "Product of roots formula."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum of roots of 3x^2 − 6x + 5 = 0 is:",
     "options": ["−2", "2", "5/3", "−5/3"],
     "answer": "2",
     "explanation": "Sum = −b/a = −(−6)/3 = 2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Product of roots of 3x^2 − 6x + 5 = 0 is:",
     "options": ["−5/3", "5/3", "−6/3", "6/3"],
     "answer": "5/3",
     "explanation": "Product = c/a = 5/3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Find the quadratic whose roots are 3 and −5.",
     "options": ["x^2 + 2x − 15 = 0", "x^2 − 2x − 15 = 0", "x^2 + 8x − 15 = 0", "x^2 − 8x − 15 = 0"],
     "answer": "x^2 + 2x − 15 = 0",
     "explanation": "Sum −2, product −15 → x^2 − (sum)x + product = x^2 + 2x − 15."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "If one root of x^2 + bx + 12 = 0 is 4, the other root and b are:",
     "options": ["3 and −7", "3 and 7", "−3 and 7", "−3 and −7"],
     "answer": "3 and −7",
     "explanation": "Product 12 = 4·β → β = 3; sum 7 = −b → b = −7."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "The product of two consecutive positive integers is 132. The smaller integer is:",
     "options": ["10", "11", "12", "13"],
     "answer": "11",
     "explanation": "x(x + 1) = 132 → x^2 + x − 132 = 0 → (x − 11)(x + 12) = 0 → x = 11 (reject −12)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "A rectangle's length is 4 m more than its width and area is 192 m². Width is:",
     "options": ["10 m", "12 m", "14 m", "16 m"],
     "answer": "12 m",
     "explanation": "x(x + 4) = 192 → x^2 + 4x − 192 = 0 → x = 12 (reject −16)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-08", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "The sum of a number and its reciprocal is 10/3. The number is:",
     "options": ["1/3 or 3", "1/2 or 2", "2/3 or 3/2", "1 or 3"],
     "answer": "1/3 or 3",
     "explanation": "x + 1/x = 10/3 → 3x^2 − 10x + 3 = 0 → (3x − 1)(x − 3) = 0 → x = 1/3 or 3."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve 4x^2 − 9 = 0.",
     "options": ["±3/2", "±2/3", "±9/4", "±9"],
     "answer": "±3/2",
     "explanation": "x^2 = 9/4 → x = ±3/2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve 3x^2 − 5x − 2 = 0.",
     "options": ["2, −1/3", "−2, 1/3", "1, −2/3", "−1, 2/3"],
     "answer": "2, −1/3",
     "explanation": "Split 3x^2 − 6x + x − 2 = 0 → 3x(x − 2) + 1·(x − 2) = (x − 2)(3x + 1) = 0; x = 2, −1/3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve x^2 − 3x − 28 = 0.",
     "options": ["−4, 7", "4, −7", "4, 7", "−4, −7"],
     "answer": "−4, 7",
     "explanation": "(x − 7)(x + 4) = 0 → x = 7 or −4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve 3x^2 − 7x + 2 = 0 using the formula.",
     "options": ["2, 1/3", "1/3, 1/2", "2, 3", "−2, −1/3"],
     "answer": "2, 1/3",
     "explanation": "D = 49 − 24 = 25 → x = (7 ± 5)/6 = 2 or 1/3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve 5x^2 − 6x − 2 = 0.",
     "options": ["(3 ± √19)/5", "(3 ± √7)/5", "(6 ± √19)/5", "(6 ± √7)/5"],
     "answer": "(3 ± √19)/5",
     "explanation": "D = 36 + 40 = 76; x = (6 ± √76)/10 = (6 ± 2√19)/10 = (3 ± √19)/5."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "Find k for which x^2 + 4x + k = 0 has REAL AND DISTINCT roots.",
     "options": ["k > 4", "k < 4", "k ≥ 4", "k = 4"],
     "answer": "k < 4",
     "explanation": "D = 16 − 4k > 0 → k < 4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-06", "difficulty": "HARD", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "For x^2 + 2(k − 1)x + (k + 5) = 0 to have equal roots, k =",
     "options": ["−1 or 4", "1 or 4", "1 or −4", "−1 or −4"],
     "answer": "−1 or 4",
     "explanation": "D = 4(k − 1)^2 − 4(k + 5) = 0 → (k − 1)^2 = k + 5 → k^2 − 3k − 4 = 0 → (k − 4)(k + 1) = 0."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "If α + β = 6 and αβ = 4, the quadratic with these roots is:",
     "options": ["x^2 − 6x + 4 = 0", "x^2 + 6x + 4 = 0", "x^2 − 6x − 4 = 0", "x^2 + 6x − 4 = 0"],
     "answer": "x^2 − 6x + 4 = 0",
     "explanation": "x^2 − (sum)x + (product) = x^2 − 6x + 4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-07", "difficulty": "HARD", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "If α and β are roots of 2x^2 − 5x + 3 = 0, then α^2 + β^2 =",
     "options": ["13/4", "19/4", "25/4", "21/4"],
     "answer": "13/4",
     "explanation": "Sum = 5/2, product = 3/2. α^2 + β^2 = (sum)^2 − 2·(product) = 25/4 − 3 = 13/4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-08", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "The sum of squares of two consecutive odd positive integers is 290. The integers are:",
     "options": ["9 and 11", "11 and 13", "13 and 15", "15 and 17"],
     "answer": "11 and 13",
     "explanation": "(x)^2 + (x + 2)^2 = 290 → 2x^2 + 4x − 286 = 0 → x^2 + 2x − 143 = 0 → (x − 11)(x + 13) = 0; x = 11."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-08", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "A train travels 360 km at a uniform speed. If the speed had been 5 km/h more, it would have taken 1 hour less. The original speed is:",
     "options": ["35 km/h", "40 km/h", "45 km/h", "50 km/h"],
     "answer": "40 km/h",
     "explanation": "Let speed = x. 360/x − 360/(x + 5) = 1 → x^2 + 5x − 1800 = 0 → (x − 40)(x + 45) = 0 → x = 40."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "Which value cannot be a coefficient 'a' in a quadratic equation?",
     "options": ["1", "−2", "0", "3.5"],
     "answer": "0",
     "explanation": "If a = 0 the equation isn't quadratic."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-01", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Re-arrange 2x^2 = 4x + 6 in standard form.",
     "options": ["2x^2 + 4x − 6 = 0", "2x^2 − 4x − 6 = 0", "2x^2 + 4x + 6 = 0", "2x^2 − 4x + 6 = 0"],
     "answer": "2x^2 − 4x − 6 = 0",
     "explanation": "Move everything to LHS."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Verify: is x = 0 a root of x^2 − 5x = 0?",
     "options": ["Yes", "No", "Only with x = 5", "Cannot say"],
     "answer": "Yes",
     "explanation": "0 − 0 = 0 ✓; (the other root is x = 5)."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-04", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "By completing the square, solve 2x^2 + 8x + 3 = 0.",
     "options": ["−2 ± √(5/2)", "−2 ± √(10)/2", "(−4 ± √10)/2", "(−2 ± √2)"],
     "answer": "(−4 ± √10)/2",
     "explanation": "Divide by 2: x^2 + 4x + 3/2 = 0 → x^2 + 4x = −3/2 → (x + 2)^2 = 4 − 3/2 = 5/2 → x = −2 ± √(5/2) = (−4 ± √10)/2."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-QE-05", "difficulty": "HARD", "cognitive_level": "APPLY", "marks": 2,
     "question": "Solve x^2 + x − 1 = 0.",
     "options": ["(−1 ± √5)/2", "(1 ± √5)/2", "(−1 ± √3)/2", "(1 ± √3)/2"],
