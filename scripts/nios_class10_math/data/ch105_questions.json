{
  "_meta": {"chapter_id": 105, "title": "Arithmetic Progressions", "board": "NIOS", "class_level": 10, "subject": "Mathematics"},
  "questions": [

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "An arithmetic progression is a sequence whose consecutive terms differ by:",
     "options": ["a constant ratio", "a constant amount", "an increasing amount", "a random amount"],
     "answer": "a constant amount",
     "explanation": "AP means common DIFFERENCE is constant; constant ratio is GP."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "Which sequence is an AP?",
     "options": ["1, 4, 9, 16, 25", "2, 5, 8, 11, 14", "1, 2, 4, 8, 16", "1, 1, 2, 3, 5"],
     "answer": "2, 5, 8, 11, 14",
     "explanation": "Differences: 3, 3, 3, 3 — all equal."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "Which sequence is NOT an AP?",
     "options": ["7, 11, 15, 19", "10, 7, 4, 1", "3, 3, 3, 3", "1, 4, 9, 16"],
     "answer": "1, 4, 9, 16",
     "explanation": "Differences: 3, 5, 7 — not constant."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The common difference of the AP 8, 13, 18, 23, … is:",
     "options": ["3", "4", "5", "6"], "answer": "5",
     "explanation": "13 − 8 = 5; 18 − 13 = 5; constant."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The common difference of the AP 10, 7, 4, 1, … is:",
     "options": ["3", "−3", "−2", "−4"], "answer": "−3",
     "explanation": "7 − 10 = −3; constant."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "If d = 0 in an AP, the AP is:",
     "options": ["increasing", "decreasing", "constant", "geometric"], "answer": "constant",
     "explanation": "All terms equal a."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "An AP with d > 0 is called:",
     "options": ["decreasing", "constant", "increasing", "alternating"], "answer": "increasing",
     "explanation": "Each term exceeds the previous one."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "An AP with d < 0 is called:",
     "options": ["decreasing", "constant", "increasing", "geometric"], "answer": "decreasing",
     "explanation": "Each term is smaller than the previous."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "Which value of x makes 2x + 1, x + 4, 3x − 2 a 3-term AP?",
     "options": ["1", "2", "3", "4"], "answer": "3",
     "explanation": "Middle = (first + third)/2 → 2(x + 4) = (2x + 1) + (3x − 2) → 2x + 8 = 5x − 1 → x = 3."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "Which of these is the standard form of an AP?",
     "options": ["a, a·d, a·d², …", "a, a + d, a + 2d, …", "a, a + 1, a + 2, …", "a, 2a, 3a, …"],
     "answer": "a, a + d, a + 2d, …",
     "explanation": "Common-difference form."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The nth term of an AP with first term a and common difference d is:",
     "options": ["a + n·d", "a + (n − 1)·d", "a − (n − 1)·d", "n·a + d"],
     "answer": "a + (n − 1)·d",
     "explanation": "(n − 1) steps of size d carry a₁ to aₙ."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The 10th term of the AP 2, 5, 8, 11, … is:",
     "options": ["27", "29", "30", "32"], "answer": "29",
     "explanation": "a = 2, d = 3; a₁₀ = 2 + 9·3 = 29."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The 20th term of the AP 5, 9, 13, 17, … is:",
     "options": ["77", "81", "83", "89"], "answer": "81",
     "explanation": "a = 5, d = 4; a₂₀ = 5 + 19·4 = 5 + 76 = 81."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The 15th term of the AP 7, 10, 13, 16, … is:",
     "options": ["46", "47", "48", "49"], "answer": "49",
     "explanation": "a = 7, d = 3; a₁₅ = 7 + 14·3 = 49."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "The 30th term of the AP 1, 7, 13, 19, … is:",
     "options": ["169", "173", "175", "181"], "answer": "175",
     "explanation": "a = 1, d = 6; a₃₀ = 1 + 29·6 = 175."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "The 12th term of the AP 100, 95, 90, 85, … is:",
     "options": ["40", "45", "50", "55"], "answer": "45",
     "explanation": "a = 100, d = −5; a₁₂ = 100 + 11·(−5) = 45."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The 11th term of the AP 4, 9, 14, 19, … is:",
     "options": ["49", "54", "59", "64"], "answer": "54",
     "explanation": "a = 4, d = 5; a₁₁ = 4 + 10·5 = 54."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "The 25th term of the AP 6, 9, 12, 15, … is:",
     "options": ["72", "75", "78", "82"], "answer": "78",
     "explanation": "a = 6, d = 3; a₂₅ = 6 + 24·3 = 78."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Which term of the AP 3, 7, 11, 15, … is 99?",
     "options": ["24th", "25th", "26th", "27th"], "answer": "25th",
     "explanation": "3 + (n − 1)·4 = 99 → n − 1 = 24 → n = 25."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Which term of the AP 5, 9, 13, 17, … is 81?",
     "options": ["18th", "19th", "20th", "21st"], "answer": "20th",
     "explanation": "5 + (n − 1)·4 = 81 → n = 20."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Which term of the AP 21, 18, 15, … is 0?",
     "options": ["7th", "8th", "9th", "10th"], "answer": "8th",
     "explanation": "21 + (n − 1)·(−3) = 0 → n − 1 = 7 → n = 8."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-03", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Is 100 a term of the AP 5, 8, 11, 14, …?",
     "options": ["Yes, 32nd", "Yes, 33rd", "No", "Yes, 35th"], "answer": "No",
     "explanation": "5 + (n − 1)·3 = 100 → n − 1 = 95/3 (not integer); 100 is NOT a term."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Which term of the AP 2, 5, 8, … is 92?",
     "options": ["29th", "30th", "31st", "32nd"], "answer": "31st",
     "explanation": "2 + (n − 1)·3 = 92 → n − 1 = 30 → n = 31."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-03", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Which term of the AP 100, 96, 92, … equals 0?",
     "options": ["24th", "25th", "26th", "27th"], "answer": "26th",
     "explanation": "100 + (n − 1)·(−4) = 0 → n − 1 = 25 → n = 26."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-04", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "If a₄ = 14 and a₁₀ = 38, the common difference d is:",
     "options": ["3", "4", "5", "6"], "answer": "4",
     "explanation": "d = (38 − 14)/(10 − 4) = 4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-04", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "If the 5th term of an AP is 17 and the 9th term is 33, the first term is:",
     "options": ["1", "2", "3", "5"], "answer": "1",
     "explanation": "d = (33 − 17)/4 = 4; a = 17 − 4·4 = 1."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-04", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "If the 3rd term of an AP is 7 and the 7th term is 19, the AP is:",
     "options": ["1, 4, 7, 10, …", "2, 5, 8, 11, …", "3, 6, 9, 12, …", "1, 5, 9, 13, …"],
     "answer": "1, 4, 7, 10, …",
     "explanation": "d = (19 − 7)/(7 − 3) = 3; a = 7 − 2·3 = 1."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-04", "difficulty": "MEDIUM", "cognitive_level": "ANALYZE", "marks": 2,
     "question": "The 6th term of an AP is 19 and the 11th term is 39. The common difference is:",
     "options": ["3", "4", "5", "6"], "answer": "4",
     "explanation": "d = (39 − 19)/(11 − 6) = 4."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The sum of the first n terms of an AP is:",
     "options": ["n·(2a + (n − 1)d)", "n/2 · [2a + (n − 1)d]", "n·a + d", "(n − 1)/2 · [2a + n·d]"],
     "answer": "n/2 · [2a + (n − 1)d]",
     "explanation": "Standard sum formula."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum of the first 10 terms of the AP 2, 5, 8, 11, … is:",
     "options": ["145", "150", "155", "160"], "answer": "155",
     "explanation": "S₁₀ = 10/2·[2·2 + 9·3] = 5·31 = 155."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum of the first 20 terms of the AP 5, 8, 11, … is:",
     "options": ["620", "650", "670", "700"], "answer": "670",
     "explanation": "S₂₀ = 20/2·[10 + 19·3] = 10·67 = 670."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Sum of the first 15 terms of the AP 7, 10, 13, … is:",
     "options": ["390", "420", "435", "450"], "answer": "420",
     "explanation": "S₁₅ = 15/2·[14 + 14·3] = 15/2·56 = 420."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Sum of the first 12 terms of the AP 1, 5, 9, 13, … is:",
     "options": ["272", "276", "288", "300"], "answer": "276",
     "explanation": "S₁₂ = 12/2·[2 + 11·4] = 6·46 = 276."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "If the last term of an AP is l, the sum can be written as:",
     "options": ["n · (a + l)", "n/2 · (a + l)", "(a + l)/2", "n · a · l"],
     "answer": "n/2 · (a + l)",
     "explanation": "Pair-sum formula."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum of 2 + 4 + 6 + … + 100 is:",
     "options": ["2500", "2550", "2600", "5050"], "answer": "2550",
     "explanation": "n = 50, S = 50/2·(2 + 100) = 2550."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum 1 + 2 + 3 + … + 100 is:",
     "options": ["4950", "5000", "5050", "5100"], "answer": "5050",
     "explanation": "n(n + 1)/2 = 100·101/2 = 5050."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum 1 + 3 + 5 + … + 99 is:",
     "options": ["2400", "2450", "2500", "2600"], "answer": "2500",
     "explanation": "AP a = 1, d = 2; n = 50; S = 50/2·(1 + 99) = 2500."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "Sum of 5 + 10 + 15 + … + 100 is:",
     "options": ["1000", "1050", "1100", "1200"], "answer": "1050",
     "explanation": "n = 20; S = 20/2·(5 + 100) = 1050."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The arithmetic mean of a and b is:",
     "options": ["√(a · b)", "(a + b)/2", "(a − b)/2", "2/(a + b)"],
     "answer": "(a + b)/2",
     "explanation": "By definition; (a, AM, b) is an AP."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "AM of 17 and 23 is:",
     "options": ["19", "20", "21", "22"], "answer": "20",
     "explanation": "(17 + 23)/2 = 20."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "AM of 50 and 90 is:",
     "options": ["60", "65", "70", "75"], "answer": "70",
     "explanation": "(50 + 90)/2 = 70."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "If 4 arithmetic means are inserted between 3 and 23, the common difference is:",
     "options": ["3", "4", "5", "6"], "answer": "4",
     "explanation": "d = (23 − 3)/(4 + 1) = 4."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "MEDIUM", "cognitive_level": "APPLY", "marks": 2,
     "question": "If 5 arithmetic means are inserted between 7 and 25, the common difference is:",
     "options": ["2", "3", "4", "6"], "answer": "3",
     "explanation": "d = (25 − 7)/(5 + 1) = 3."},

    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-08", "difficulty": "MEDIUM", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "Sita borrows ₹3000 and repays in 12 monthly instalments, the first being ₹500 and each next ₹25 less. Total she pays is:",
     "options": ["₹3000", "₹4350", "₹5000", "₹6000"], "answer": "₹4350",
     "explanation": "S₁₂ = 12/2·[1000 + 11·(−25)] = 6·725 = 4350."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-08", "difficulty": "MEDIUM", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "A boy saves ₹5 in week 1, ₹7 in week 2, ₹9 in week 3, …. In 30 weeks he saves:",
     "options": ["₹930", "₹990", "₹1020", "₹1050"], "answer": "₹1020",
     "explanation": "S₃₀ = 30/2·[10 + 29·2] = 15·68 = 1020."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-08", "difficulty": "MEDIUM", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "An employee starts at ₹20000 with annual increment ₹1500. Salary in 8th year is:",
     "options": ["₹29500", "₹30500", "₹31500", "₹32500"], "answer": "₹30500",
     "explanation": "a + 7d = 20000 + 7·1500 = 30500."},
    {"type": "MCQ", "outcome_code": "10-NIOS-MATH-AP-08", "difficulty": "MEDIUM", "cognitive_level": "EVALUATE", "marks": 2,
     "question": "A factory makes 50 units in week 1 and adds 10 each week. Production in week 12 is:",
     "options": ["150", "160", "170", "180"], "answer": "160",
     "explanation": "a + 11d = 50 + 110 = 160."},

    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "Every AP has a constant ratio between consecutive terms.",
     "options": ["True", "False"], "answer": "False",
     "explanation": "AP has constant DIFFERENCE; constant ratio is GP."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "1, 4, 9, 16, 25 is an AP.",
     "options": ["True", "False"], "answer": "False",
     "explanation": "Differences 3, 5, 7, 9 are not constant."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "An AP can have a negative common difference.",
     "options": ["True", "False"], "answer": "True",
     "explanation": "d < 0 gives a decreasing AP."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The nth term of an AP is given by aₙ = a + n·d.",
     "options": ["True", "False"], "answer": "False",
     "explanation": "Formula is a + (n − 1)·d, not a + n·d."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "Sₙ = n/2·[2a + (n − 1)d] gives the sum of the first n terms.",
     "options": ["True", "False"], "answer": "True",
     "explanation": "Standard sum formula."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "When the last term l is known, the sum is Sₙ = n/2·(a + l).",
     "options": ["True", "False"], "answer": "True",
     "explanation": "Equivalent (a + l) form."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "EASY", "cognitive_level": "UNDERSTAND", "marks": 1,
     "question": "If A is the AM of a and b, then a, A, b is itself an AP.",
     "options": ["True", "False"], "answer": "True",
     "explanation": "Common difference (b − a)/2."},
    {"type": "TRUE_FALSE", "outcome_code": "10-NIOS-MATH-AP-07", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "Inserting n AMs between a and b uses d = (b − a)/(n + 1).",
     "options": ["True", "False"], "answer": "True",
     "explanation": "(n + 1) gaps between (n + 2) terms."},

    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "The common difference of an AP is denoted by ____.",
     "answer": "d", "explanation": "Standard notation."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-AP-01", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "For the AP 11, 8, 5, 2, …, the common difference is ____.",
     "answer": "−3", "explanation": "8 − 11 = −3."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "REMEMBER", "marks": 1,
     "question": "aₙ = a + (n − ____)·d.",
     "answer": "1", "explanation": "Standard formula."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-AP-02", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "The 7th term of the AP 4, 9, 14, 19, … is ____.",
     "answer": "34", "explanation": "a = 4, d = 5; a₇ = 4 + 6·5 = 34."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-AP-05", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum of the first n natural numbers is ____.",
     "answer": "n(n + 1)/2", "explanation": "Sₙ for AP 1, 2, 3, …, n."},
    {"type": "FILL_BLANK", "outcome_code": "10-NIOS-MATH-AP-06", "difficulty": "EASY", "cognitive_level": "APPLY", "marks": 1,
     "question": "Sum of 2 + 4 + 6 + … + 50 is ____.",
