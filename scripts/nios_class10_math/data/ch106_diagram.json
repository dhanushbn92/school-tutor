    {
      "label": "Two key formulas",
      "details": [
        "x % of A = (x/100)·A",
        "A as % of B = (A/B)·100 %"
      ]
    },
    {
      "label": "Increase / decrease",
      "details": [
        "Change = New − Old",
        "% change = Change/Old · 100",
        "Multiplier 1 ± p/100",
        "Successive: p+q+pq/100"
      ]
    },
    {
      "label": "Profit / loss",
      "details": [
        "ALWAYS on CP",
        "Profit % = Profit/CP · 100",
        "SP = CP·(1 ± gain%/100)",
        "CP = SP/(1 ± gain%/100)"
      ]
    },
    {
      "label": "Discount",
      "details": [
        "ALWAYS on MP",
        "SP = MP·(1 − d/100)",
        "Two discounts → multiply factors"
      ]
    },
    {
      "label": "Interest",
      "details": [
        "SI = Prt/100 (flat)",
        "CI yearly: A = P(1 + r/100)^t",
        "Sub-annual: r → r/n, t → n·t",
        "2-yr shortcut: CI − SI = P(r/100)^2"
      ]
    }
