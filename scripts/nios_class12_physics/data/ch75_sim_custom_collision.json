{
  "template": "custom_html",
  "title": "1D Collision sandbox — momentum vs energy",
  "instructions": "Two carts on a frictionless track. Adjust each cart's mass and initial velocity, pick the collision type, then press Launch. Watch how total momentum is always conserved while kinetic energy is conserved only in elastic collisions.",
  "outcome_codes_covered": ["12-NIOS-PHY-LM-05", "12-NIOS-PHY-LM-06"],
  "custom": {
    "requires_libraries": [],
    "html_body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>1D Collision sandbox</title>\n<style>\n  :root { --bg:#0b1020; --panel:rgba(15,20,35,0.92); --border:rgba(255,255,255,0.12); --text:#e8ecf5; --muted:#9aa3b2; --accent:#22d3ee; --c1:#3b82f6; --c2:#f97316; --p:#fbbf24; --ke:#22c55e; }\n  html,body { margin:0; padding:0; height:100%; background:var(--bg); color:var(--text); font-family:-apple-system,'Segoe UI',Roboto,sans-serif; overflow:hidden; }\n  #root { display:grid; grid-template-rows: 1fr auto; height:100%; }\n  #stage { position:relative; }\n  canvas { width:100%; height:100%; display:block; }\n  #panel { background:var(--panel); border-top:1px solid var(--border); padding:14px 18px; display:grid; grid-template-columns: repeat(2, 1fr) auto; gap:18px; align-items:start; max-height:42vh; overflow:auto; }\n  .col h2 { margin:0 0 8px; font-size:11px; text-transform:uppercase; letter-spacing:0.06em; color:var(--muted); }\n  .row { display:grid; grid-template-columns: 90px 1fr 70px; align-items:center; gap:10px; margin:6px 0; font-size:13px; }\n  .row label { color:#cdd5e2; }\n  .row input[type=range] { width:100%; accent-color:var(--accent); }\n  .row .v { text-align:right; color:var(--accent); font-variant-numeric:tabular-nums; font-size:12px; }\n  .modes { display:flex; gap:8px; margin-top:8px; }\n  .modes button { background:var(--bg); color:var(--text); border:1px solid var(--border); border-radius:999px; padding:5px 12px; font-size:12px; cursor:pointer; }\n  .modes button.active { background:var(--accent); color:var(--bg); border-color:var(--accent); }\n  .actions { display:flex; flex-direction:column; gap:10px; align-items:flex-end; }\n  button.primary { background:var(--accent); color:var(--bg); border:1px solid var(--accent); border-radius:999px; padding:9px 20px; font-size:13px; font-weight:600; cursor:pointer; }\n  button.primary:hover { filter:brightness(1.1); }\n  button.ghost { background:transparent; color:var(--text); border:1px solid var(--border); border-radius:999px; padding:7px 16px; font-size:12px; cursor:pointer; }\n  button.ghost:hover { border-color:var(--accent); color:var(--accent); }\n  #bars { margin-top:6px; font-size:12px; color:var(--muted); }\n  .barRow { display:grid; grid-template-columns: 110px 1fr 90px; gap:8px; align-items:center; margin:6px 0; }\n  .bar { position:relative; height:14px; background:rgba(255,255,255,0.06); border-radius:7px; overflow:hidden; }\n  .bar > span { position:absolute; top:0; left:0; height:100%; transition: width 350ms ease, background 200ms ease; }\n  .bar.p > span { background:var(--p); }\n  .bar.ke > span { background:var(--ke); }\n  .num { color:#dbe1ec; font-variant-numeric:tabular-nums; text-align:right; }\n  .label-c1 { color:var(--c1); font-weight:600; }\n  .label-c2 { color:var(--c2); font-weight:600; }\n  .conserve-tag { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(34,197,94,0.18); color:var(--ke); font-size:11px; margin-left:6px; }\n  .conserve-tag.bad { background:rgba(239,68,68,0.18); color:#fca5a5; }\n</style>\n</head>\n<body>\n<div id=\"root\">\n  <div id=\"stage\"><canvas id=\"c\"></canvas></div>\n  <div id=\"panel\">\n    <div class=\"col\">\n      <h2><span class=\"label-c1\">Cart A</span></h2>\n      <div class=\"row\"><label>Mass</label><input id=\"mA\" type=\"range\" min=\"0.5\" max=\"10\" step=\"0.1\" value=\"2\" /><span class=\"v\" id=\"mA-v\"></span></div>\n      <div class=\"row\"><label>Velocity</label><input id=\"vA\" type=\"range\" min=\"-10\" max=\"10\" step=\"0.1\" value=\"4\" /><span class=\"v\" id=\"vA-v\"></span></div>\n      <div class=\"col\" style=\"margin-top:14px\"><h2>Collision type</h2>\n        <div class=\"modes\"><button data-mode=\"elastic\" id=\"m-elastic\">Elastic</button><button data-mode=\"inelastic\" id=\"m-inelastic\">Perfectly inelastic</button></div>\n      </div>\n    </div>\n    <div class=\"col\">\n      <h2><span class=\"label-c2\">Cart B</span></h2>\n      <div class=\"row\"><label>Mass</label><input id=\"mB\" type=\"range\" min=\"0.5\" max=\"10\" step=\"0.1\" value=\"3\" /><span class=\"v\" id=\"mB-v\"></span></div>\n      <div class=\"row\"><label>Velocity</label><input id=\"vB\" type=\"range\" min=\"-10\" max=\"10\" step=\"0.1\" value=\"-2\" /><span class=\"v\" id=\"vB-v\"></span></div>\n      <div id=\"bars\"></div>\n    </div>\n    <div class=\"actions\"><button class=\"primary\" id=\"go\">Launch</button><button class=\"ghost\" id=\"reset\">Reset</button></div>\n  </div>\n</div>\n<script>\n(function () {\n  var canvas = document.getElementById('c');\n  var ctx = canvas.getContext('2d');\n  var dpr = Math.min(window.devicePixelRatio || 1, 2);\n  var W = 0, H = 0;\n  function resize() {\n    var r = canvas.parentElement.getBoundingClientRect();\n    W = r.width; H = r.height;\n    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);\n    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  var state = { mA: 2, vA: 4, mB: 3, vB: -2, mode: 'elastic' };\n  var sim = null;     // { xA, xB, vA, vB, collided }\n  var startM = null;  // initial mom + KE for the readout bars\n\n  function readControls() {\n    state.mA = parseFloat(document.getElementById('mA').value);\n    state.vA = parseFloat(document.getElementById('vA').value);\n    state.mB = parseFloat(document.getElementById('mB').value);\n    state.vB = parseFloat(document.getElementById('vB').value);\n    document.getElementById('mA-v').textContent = state.mA.toFixed(1) + ' kg';\n    document.getElementById('vA-v').textContent = state.vA.toFixed(1) + ' m/s';\n    document.getElementById('mB-v').textContent = state.mB.toFixed(1) + ' kg';\n    document.getElementById('vB-v').textContent = state.vB.toFixed(1) + ' m/s';\n    drawScene();\n    updateBars();\n  }\n  function setMode(m) {\n    state.mode = m;\n    document.getElementById('m-elastic').classList.toggle('active', m === 'elastic');\n    document.getElementById('m-inelastic').classList.toggle('active', m === 'inelastic');\n    updateBars();\n  }\n  ['mA','vA','mB','vB'].forEach(function(id){ document.getElementById(id).addEventListener('input', readControls); });\n  document.getElementById('m-elastic').addEventListener('click', function(){ setMode('elastic'); });\n  document.getElementById('m-inelastic').addEventListener('click', function(){ setMode('inelastic'); });\n\n  function totals(vA, vB) {\n    return {\n      pA: state.mA * vA, pB: state.mB * vB, p: state.mA * vA + state.mB * vB,\n      keA: 0.5 * state.mA * vA * vA, keB: 0.5 * state.mB * vB * vB,\n      ke: 0.5 * state.mA * vA * vA + 0.5 * state.mB * vB * vB,\n    };\n  }\n  function postCollision() {\n    if (state.mode === 'elastic') {\n      var u1 = state.vA, u2 = state.vB, m1 = state.mA, m2 = state.mB;\n      var v1 = ((m1 - m2) * u1 + 2 * m2 * u2) / (m1 + m2);\n      var v2 = ((m2 - m1) * u2 + 2 * m1 * u1) / (m1 + m2);\n      return { vA: v1, vB: v2 };\n    } else {\n      var v = (state.mA * state.vA + state.mB * state.vB) / (state.mA + state.mB);\n      return { vA: v, vB: v };\n    }\n  }\n\n  function updateBars() {\n    var pre = totals(state.vA, state.vB);\n    var post = postCollision();\n    var postT = totals(post.vA, post.vB);\n    var maxAbsP = Math.max(Math.abs(pre.p), Math.abs(postT.p), 1);\n    var maxKE = Math.max(pre.ke, postT.ke, 1);\n    var pConserved = Math.abs(pre.p - postT.p) < 1e-6;\n    var keConserved = Math.abs(pre.ke - postT.ke) < 1e-6;\n    var rows = '' +\n      barRow('Momentum (before)', pre.p, maxAbsP, 'p', pre.p.toFixed(2) + ' kg·m/s') +\n      barRow('Momentum (after)',  postT.p, maxAbsP, 'p', postT.p.toFixed(2) + ' kg·m/s' + (pConserved ? ' <span class=\"conserve-tag\">conserved</span>' : ' <span class=\"conserve-tag bad\">DRIFT</span>')) +\n      barRow('KE (before)', pre.ke, maxKE, 'ke', pre.ke.toFixed(2) + ' J') +\n      barRow('KE (after)',  postT.ke, maxKE, 'ke', postT.ke.toFixed(2) + ' J' + (keConserved ? ' <span class=\"conserve-tag\">conserved</span>' : ' <span class=\"conserve-tag bad\">' + ((postT.ke - pre.ke)/pre.ke * 100).toFixed(0) + '% Δ</span>'));\n    document.getElementById('bars').innerHTML = rows;\n  }\n\n  function barRow(label, val, max, kind, num) {\n    var pct = Math.min(100, Math.abs(val) / max * 100);\n    return '<div class=\"barRow\"><div>' + label + '</div>' +\n           '<div class=\"bar ' + kind + '\"><span style=\"width:' + pct.toFixed(0) + '%\"></span></div>' +\n           '<div class=\"num\">' + num + '</div></div>';\n  }\n\n  // --- Drawing ---------------------------------------------------------\n  function drawScene() {\n    if (!W || !H) return;\n    ctx.fillStyle = '#0b1020'; ctx.fillRect(0, 0, W, H);\n    var trackY = H * 0.6;\n    // Track\n    ctx.strokeStyle = 'rgba(255,255,255,0.18)';\n    ctx.lineWidth = 2;\n    ctx.beginPath(); ctx.moveTo(W*0.05, trackY); ctx.lineTo(W*0.95, trackY); ctx.stroke();\n    // Tick marks\n    ctx.strokeStyle = 'rgba(255,255,255,0.08)';\n    ctx.lineWidth = 1;\n    for (var i = 0; i <= 10; i++) {\n      var x = W*0.05 + (W*0.9) * (i/10);\n      ctx.beginPath(); ctx.moveTo(x, trackY); ctx.lineTo(x, trackY + 6); ctx.stroke();\n    }\n    // Carts\n    drawCart(sim ? sim.xA : 0.3, state.mA, '#3b82f6', 'A', sim ? sim.vA : state.vA, trackY);\n    drawCart(sim ? sim.xB : 0.7, state.mB, '#f97316', 'B', sim ? sim.vB : state.vB, trackY);\n  }\n  function drawCart(xPct, m, color, label, v, trackY) {\n    var x = W*0.05 + (W*0.9) * xPct;\n    var size = 22 + Math.sqrt(m) * 6;     // bigger = heavier\n    ctx.fillStyle = color;\n    ctx.fillRect(x - size/2, trackY - size, size, size);\n    ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n    ctx.strokeRect(x - size/2, trackY - size, size, size);\n    ctx.fillStyle = '#fff';\n    ctx.font = 'bold 16px ui-sans-serif';\n    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n    ctx.fillText(label, x, trackY - size/2);\n    // Velocity arrow\n    var mag = Math.min(60, Math.abs(v) * 6);\n    var dir = v >= 0 ? 1 : -1;\n    if (mag > 2) {\n      ctx.strokeStyle = color; ctx.lineWidth = 3;\n      var ax = x + dir * (size/2 + 4), ay = trackY - size/2;\n      ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(ax + dir*mag, ay); ctx.stroke();\n      ctx.beginPath(); ctx.moveTo(ax + dir*mag, ay); ctx.lineTo(ax + dir*(mag-7), ay-5); ctx.lineTo(ax + dir*(mag-7), ay+5); ctx.closePath(); ctx.fill();\n    }\n    // m, v label below the cart\n    ctx.fillStyle = '#cdd5e2'; ctx.font = '12px ui-monospace,Consolas,monospace';\n    ctx.fillText(m.toFixed(1) + ' kg · ' + v.toFixed(1) + ' m/s', x, trackY + 22);\n  }\n\n  // --- Animation -------------------------------------------------------\n  var running = false, lastT = 0;\n  function start() {\n    sim = { xA: 0.2, xB: 0.7, vA: state.vA, vB: state.vB, collided: false };\n    running = true; lastT = performance.now();\n    requestAnimationFrame(step);\n  }\n  function step(t) {\n    if (!running) return;\n    var dt = Math.min(0.04, (t - lastT) / 1000);\n    lastT = t;\n    var trackLen = 12;     // metres represented by 0..1 of canvas width\n    sim.xA += sim.vA * dt / trackLen;\n    sim.xB += sim.vB * dt / trackLen;\n    if (!sim.collided && sim.xA + 0.04 >= sim.xB - 0.04 && sim.vA - sim.vB > 0) {\n      var post = postCollision();\n      sim.vA = post.vA; sim.vB = post.vB;\n      sim.collided = true;\n    }\n    if (sim.xA < -0.05 || sim.xB > 1.05 || (sim.collided && Math.abs(sim.vA) + Math.abs(sim.vB) < 0.05)) {\n      running = false;\n    }\n    drawScene();\n    if (running) requestAnimationFrame(step);\n  }\n  document.getElementById('go').addEventListener('click', start);\n  document.getElementById('reset').addEventListener('click', function () {\n    running = false; sim = null; drawScene(); updateBars();\n  });\n\n  setMode('elastic');\n  readControls();\n})();\n</script>\n</body>\n</html>\n"
  }
}
